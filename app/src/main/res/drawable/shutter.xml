<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="4dp" android:color="#F4F4F5" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item android:bottom="9dp" android:left="9dp" android:right="9dp" android:top="9dp">
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="oval"><solid android:color="#A1A1AA" /></shape>
            </item>
            <item>
                <shape android:shape="oval"><solid android:color="#F4F4F5" /></shape>
            </item>
        </selector>
    </item>
</layer-list>
